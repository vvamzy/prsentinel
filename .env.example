# Copy to .env for local development (npm run dev / npm run dev:review).
# Never commit the real .env file.

# GitHub token with `pull-requests: write` (only needed for real runs).
GITHUB_TOKEN=

# --- GitHub App (recommended alternative to GITHUB_TOKEN) ------------------
# When both are set, the App is used and GITHUB_TOKEN is ignored.
# PRSENTINEL_APP_ID=
# PRSENTINEL_APP_PRIVATE_KEY=        # PEM, \n-escaped PEM, or base64 PEM
# PRSENTINEL_INSTALLATION_ID=        # optional; discovered from the repo

# Owner/repo to operate on when running outside GitHub Actions.
GITHUB_REPOSITORY=your-org/your-repo

# --- LLM provider ---------------------------------------------------------
# Any OpenAI-compatible provider works. See docs/configuration.md.

LLM_API_KEY=
LLM_MODEL=openai/gpt-4o-mini

# Override the API base URL for self-hosted or third-party providers:
# LLM_BASE_URL=http://localhost:11434/v1        # Ollama
# LLM_BASE_URL=http://localhost:8000/v1         # vLLM
# LLM_BASE_URL=https://openrouter.ai/api/v1     # OpenRouter
# LLM_BASE_URL=https://api.groq.com/openai/v1   # Groq

# Write the review payload to out/ instead of posting it.
DRY_RUN=true

# Repository root containing .prsentinel.yaml.
GITHUB_WORKSPACE=.
