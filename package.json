{
  "name": "prsentinel",
  "version": "0.1.0",
  "description": "Open-source AI code review for pull requests, running entirely inside GitHub Actions",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "prsentinel": "dist/index.js"
  },
  "files": [
    "dist",
    "action.yml"
  ],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/index.js --banner:js=\"import{createRequire}from'node:module';const require=createRequire(import.meta.url);\"",
    "dev": "tsx src/index.ts",
    "dev:review": "tsx scripts/dev-review.ts",
    "dev:pr": "tsx scripts/dev-review.ts --pr",
    "eval": "tsx scripts/eval.ts",
    "eval:stub": "tsx scripts/eval.ts --stub",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "guard": "node scripts/check-pr-target-safety.mjs",
    "lint": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.0",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
